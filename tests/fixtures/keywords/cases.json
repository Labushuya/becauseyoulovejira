{
  "description": "Common cases of the keyword matching (ADR-0020 §2). Both app/pb_hooks/lib/keywords.js and web/src/lib/domain/keywords.ts must give `expect` for `keywords` and `texts`.",
  "cases": [
    { "name": "case is ignored", "keywords": ["todo"], "texts": ["TODO: Steuer"], "expect": "todo" },
    { "name": "keyword in capitals", "keywords": ["TODO"], "texts": ["todo steuer"], "expect": "TODO" },
    { "name": "stored spelling is returned, trimmed", "keywords": ["  Aufgabe "], "texts": ["neue aufgabe"], "expect": "Aufgabe" },
    { "name": "umlaut keyword, umlaut text", "keywords": ["prüfen"], "texts": ["Bitte PRÜFEN"], "expect": "prüfen" },
    { "name": "umlaut keyword, ae text", "keywords": ["prüfen"], "texts": ["bitte pruefen"], "expect": "prüfen" },
    { "name": "umlaut keyword, plain text", "keywords": ["prüfen"], "texts": ["bitte prufen"], "expect": "prüfen" },
    { "name": "ae keyword, umlaut text", "keywords": ["pruefen"], "texts": ["Bitte prüfen"], "expect": "pruefen" },
    { "name": "plain keyword, umlaut text", "keywords": ["mull"], "texts": ["Müll rausbringen"], "expect": "mull" },
    { "name": "ae keyword and plain text are different words", "keywords": ["pruefen"], "texts": ["bitte prufen"], "expect": "" },
    { "name": "decomposed umlaut in the text", "keywords": ["prüfen"], "texts": ["pru\u0308fen"], "expect": "prüfen" },
    { "name": "decomposed umlaut in the keyword", "keywords": ["mu\u0308ll"], "texts": ["Muell"], "expect": "mu\u0308ll" },
    { "name": "sharp s", "keywords": ["strasse"], "texts": ["Straße fegen"], "expect": "strasse" },
    { "name": "capital sharp s", "keywords": ["straße"], "texts": ["STRAẞE FEGEN"], "expect": "straße" },
    { "name": "accents are dropped", "keywords": ["cafe"], "texts": ["Café anrufen"], "expect": "cafe" },
    { "name": "accent in the keyword", "keywords": ["Café"], "texts": ["cafe"], "expect": "Café" },
    { "name": "start of a word, longer word", "keywords": ["todo"], "texts": ["Todos für heute"], "expect": "todo" },
    { "name": "compound with hyphen", "keywords": ["todo"], "texts": ["Todo-Liste"], "expect": "todo" },
    { "name": "not inside a word", "keywords": ["todo"], "texts": ["Fotodoku"], "expect": "" },
    { "name": "not inside a word after an umlaut", "keywords": ["ticket"], "texts": ["Bähnticket"], "expect": "" },
    { "name": "after punctuation", "keywords": ["ticket"], "texts": ["(Ticket) bestellen"], "expect": "ticket" },
    { "name": "after a digit is inside a word", "keywords": ["todo"], "texts": ["2todo"], "expect": "" },
    { "name": "second occurrence at a word start", "keywords": ["todo"], "texts": ["fotodoku und todo"], "expect": "todo" },
    { "name": "hash keyword", "keywords": ["#byl"], "texts": ["Rechnung #BYL"], "expect": "#byl" },
    { "name": "hash keyword in brackets", "keywords": ["#byl"], "texts": ["(#byl)"], "expect": "#byl" },
    { "name": "hash keyword glued to a word", "keywords": ["#byl"], "texts": ["x#byl"], "expect": "" },
    { "name": "phrase", "keywords": ["zu erledigen"], "texts": ["Das ist zu   erledigen"], "expect": "zu erledigen" },
    { "name": "phrase over a line break", "keywords": ["zu erledigen"], "texts": ["Das ist zu\r\nerledigen"], "expect": "zu erledigen" },
    { "name": "phrase with no-break space", "keywords": ["zu erledigen"], "texts": ["zu\u00a0erledigen"], "expect": "zu erledigen" },
    { "name": "phrase not across two texts", "keywords": ["zu erledigen"], "texts": ["Titel zu", "erledigen"], "expect": "" },
    { "name": "second text", "keywords": ["aufgabe"], "texts": ["Kino", "Das ist eine Aufgabe"], "expect": "aufgabe" },
    { "name": "empty list", "keywords": [], "texts": ["todo"], "expect": "" },
    { "name": "no texts", "keywords": ["todo"], "texts": [], "expect": "" },
    { "name": "empty text", "keywords": ["todo"], "texts": [""], "expect": "" },
    { "name": "first keyword of the list wins", "keywords": ["ticket", "todo"], "texts": ["todo: ticket kaufen"], "expect": "ticket" },
    { "name": "empty keyword is skipped", "keywords": ["", "   ", "todo"], "texts": ["todo"], "expect": "todo" },
    { "name": "emoji before the keyword", "keywords": ["todo"], "texts": ["\ud83d\udcdd todo"], "expect": "todo" },
    { "name": "emoji directly before the keyword", "keywords": ["todo"], "texts": ["\ud83d\udcddtodo"], "expect": "todo" },
    { "name": "cyrillic letter before is a word", "keywords": ["todo"], "texts": ["жtodo"], "expect": "" },
    { "name": "typographic quote before", "keywords": ["todo"], "texts": ["„todo“"], "expect": "todo" },
    { "name": "multiplication sign before", "keywords": ["todo"], "texts": ["2×todo"], "expect": "todo" },
    { "name": "greek final sigma", "keywords": ["\u039f\u0394\u039f\u03a3"], "texts": ["\u03bf\u03b4\u03bf\u03c2"], "expect": "\u039f\u0394\u039f\u03a3" },
    { "name": "keyword longer than the text", "keywords": ["erledigen"], "texts": ["erle"], "expect": "" },
    { "name": "hyphenated keyword", "keywords": ["europa-go"], "texts": ["Neu bei europa-go"], "expect": "europa-go" },
    { "name": "hyphenated keyword, other case", "keywords": ["europa-go"], "texts": ["Europa-Go Reisen"], "expect": "europa-go" },
    { "name": "hyphenated keyword in capitals", "keywords": ["Europa-Go"], "texts": ["EUROPA-GO"], "expect": "Europa-Go" },
    { "name": "hyphenated keyword in a domain", "keywords": ["europa-go"], "texts": ["www.europa-go.de"], "expect": "europa-go" },
    { "name": "hyphenated keyword as domain alone", "keywords": ["europa-go"], "texts": ["europa-go.de"], "expect": "europa-go" },
    { "name": "hyphenated keyword in an address", "keywords": ["europa-go"], "texts": ["info@europa-go.de"], "expect": "europa-go" },
    { "name": "hyphenated keyword in a sender with name", "keywords": ["europa-go"], "texts": ["Reisen <info@europa-go.de>"], "expect": "europa-go" },
    { "name": "hyphenated keyword as local part", "keywords": ["europa-go"], "texts": ["<europa-go@example.com>"], "expect": "europa-go" },
    { "name": "hyphenated keyword not inside a word", "keywords": ["europa-go"], "texts": ["neueuropa-go"], "expect": "" },
    { "name": "hyphen is part of the keyword", "keywords": ["europa-go"], "texts": ["europago"], "expect": "" },
    { "name": "domain keyword", "keywords": ["europa-go.de"], "texts": ["Absender info@Europa-Go.DE"], "expect": "europa-go.de" }
  ]
}
