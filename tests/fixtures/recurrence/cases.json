    { "name": "monthly on the 30th: clamped in February", "fn": "onOrAfter", "rule": { "mode": "calendar", "freq": "monthly", "interval": 1, "month_day": 30, "anchor": "2026-01-30" }, "args": ["2026-02-01"], "expect": "2026-02-28" },
