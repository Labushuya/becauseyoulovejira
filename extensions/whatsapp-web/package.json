{
	"name": "byl-whatsapp-web",
	"version": "0.1.1",
	"private": true,
	"description": "Browser extension of becauseyoulovejira for WhatsApp Web: reads the open tab only and hands messages to the local app (ADR-0038)",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"check": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"build": "node build.mjs"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "24.19.2",
		"esbuild": "0.28.2",
		"eslint": "10.12.0",
		"globals": "17.13.0",
		"jsdom": "30.1.2",
		"prettier": "3.9.10",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"vitest": "5.0.3"
	},
	"allowScripts": {
		"esbuild": true
	}
}
